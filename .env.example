# library-query — environment template

Copy to `.env` (never commit it) and fill in. All paths and secrets the tool
needs live here so the module can be located anywhere on disk.

# Absolute path to the folder your documents live in
LIBRARY_ROOT=/absolute/path/to/library

# Qdrant (docker compose in docker/ of this module)
QDRANT_URL=http://127.0.0.1:6333

# Optional: serialized Qdrant upsert batch ceiling, default 16 MiB.
# Keep below the server request limit; deterministic point IDs make retries safe.
LIBRARY_QUERY_QDRANT_MAX_BATCH_BYTES=16777216

# OpenRouter embeddings (openai-compat endpoint)
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
OPENROUTER_API_KEY=

# Optional: override where the ledger/state lives (default ~/.local/share/library-query)
LIBRARY_QUERY_STATE=

# Optional: local Better BibTeX JSON-RPC endpoint. Used only by
# `library-query sync-zotero-notes`, which must run on the Zotero host.
ZOTERO_BBT_URL=http://127.0.0.1:23119/better-bibtex/json-rpc
ZOTERO_BBT_TIMEOUT=20
